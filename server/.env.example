# .env.example

# PostgreSQL (Neon) connection string used by Prisma
DATABASE_URL=
# Non-pooled direct connection (used by Prisma migrations against Neon)
DIRECT_URL=

# Secret used to sign JWTs — use a long random string
JWT_SECRET=

# Platform admin (SUPERADMIN). Created on first boot; password is never shown in the UI.
ADMIN_EMAIL=admin@tijartt.com
ADMIN_PASSWORD=

# Optional. production | development | test
NODE_ENV=development
# Optional. Nest listens on this port (default 4000)
PORT=4000
# Browser origin allowed for CORS (Next.js UI). Required when NODE_ENV=production.
# Production: https://tijartt.com
CLIENT_ORIGIN=http://localhost:3000

# Cloudinary — business logo uploads (compressed in a worker, stored as WebP)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Defaults to tijaratt/business-logos
CLOUDINARY_FOLDER=tijaratt/business-logos

# Keep the Neon database warm only while the app is being used.
# Number of concurrent SELECT 1 connections opened by the keep-warm loop (default 4, clamped 0..10).
DB_WARM_CONNECTIONS=4
# Idle minutes after which the keep-warm loop stops so Neon can suspend (0 disables, default 20).
DB_KEEPWARM_IDLE_MINUTES=20
# Seconds between keep-warm pings (must stay below Neon's 5-minute suspend, default 240).
DB_KEEPWARM_INTERVAL_SECONDS=240
