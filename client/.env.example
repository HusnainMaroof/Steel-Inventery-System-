# Nest API base URL (server-only — never prefix with NEXT_PUBLIC_)
# Required in production on the Next.js host.
TIJARATT_API_URL=http://127.0.0.1:4000

# Public browser origin of this Next app (BFF same-origin checks). Required in production.
# Production: https://tijaratt.com
CLIENT_ORIGIN=http://localhost:3000
